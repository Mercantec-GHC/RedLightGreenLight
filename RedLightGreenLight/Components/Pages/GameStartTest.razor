@using Domain

@page "/"

<PageTitle>Home</PageTitle>

<h1>Red Light, Green Light</h1>

@if (game is null)
{
    <button class="btn btn-primary" @onclick="JoinGame">Join Game</button>
}
else
{
    <br />
    <button class="btn btn-primary" @onclick="AddPlayer">Add Player</button>
    <button class="btn btn-primary" @onclick="AddHost">Add Host</button>
    <button class="btn btn-warning" @onclick="StartGame">Start Game</button>
    <br />
    <p>
        Game State:
        <span class="badge @GetGameStateColor()">
            @game.State
        </span>
    </p>
    <p>Players:</p>
    <ul>
        @foreach (var player in game.Players)
        {
            <li>
                @player.Name - @player.State - 
                @switch (player.State)
                {
                    case PlayerState.Waiting:
                        <button class="btn btn-primary" @onclick="() => ReadyPlayer(player)">Ready</button>
                        break;
                    case PlayerState.Ready:
                        <button class="btn btn-secondary" @onclick="() => CancelReadyPlayer(player)">Cancel Ready</button>
                        break;
                    case PlayerState.Playing:
                        <button class="btn btn-success" @onclick="() => PlayerMoved(player)">Move</button>
                        <button class="btn btn-success" @onclick="() => PlayerWon(player)">Declare Winner</button>
                        break;
                    case PlayerState.Lost:
                        <span class="badge bg-danger">Lost</span>
                        break;
                }

                <button class="btn btn-danger" @onclick="() => RemovePlayer(player)">X</button>
            </li>
        }
    </ul>
    <p>Host: @(game.Host is not null ? $"Host ID: {game.Host.Id}" : "No host assigned")</p>
    <br />
    <button class="btn btn-danger" @onclick="LeaveGame">Leave Game</button>
}

<br />
@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    Game? game;
    string message = string.Empty;

    private void JoinGame()
    {
        if (game is not null)
        {
            message = "Already joined a game.";
            return;
        }
        game = new Game();
        game.OnChanged += UpdateGame;
        message = "Joined a new game.";
    }

    private void LeaveGame()
    {
        if (game is null)
        {
            message = "No game to leave.";
            return;
        }
        game.OnChanged -= UpdateGame;
        game = null;

        message = "Left the game.";
    }

    private void AddPlayer()
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = game.AddPlayer();
        if (result == MethodResult.Success)
        {
            message = $"Player added successfully.";
        }
        else
        {
            message = $"Failed to add player: {result}";
        }
    }

    private void RemovePlayer(Player player)
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = game.RemovePlayer(player.Id);
        if (result == MethodResult.Success)
        {
            message = $"Player removed successfully.";
        }
        else message = $"Failed to remove player: {result}";
    }

    private void ReadyPlayer(Player player)
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        player.State = PlayerState.Ready;
    }

    private void CancelReadyPlayer(Player player)
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        player.State = PlayerState.Waiting;
    }

    private void PlayerMoved(Player player)
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = game.PlayerMoved(player);
        switch (result)
        {
            case MethodResult.Success:
                message = $"Player moved successfully.";
                break;

            case MethodResult.PlayerLost:
                message = $"Player {player.Name} has lost the game!";
                break;

            case MethodResult.GameOver:
                message = $"All players have lost the game.";
                break;

            default:
                message = $"Failed to move player: {result}";
                break;
        }
    }

    private void PlayerWon(Player player)
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = game.PlayerWon(player);
        switch (result)
        {
            case MethodResult.PlayerWon:
                message = $"Player {player.Name} has won the game!";
                break;
            case MethodResult.PlayerNotPlaying:
                message = $"Player {player.Name} is not currently playing.";
                break;
            default:
                message = $"Failed to declare player as winner: {result}";
                break;
        }
    }

    private void AddHost()
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = game.AddHost(1);
        if (result == MethodResult.Success)
        {
            message = $"Host added successfully.";
        }
        else
        {
            message = $"Failed to add host: {result}";
        }
    }

    private async Task StartGame()
    {
        if (game is null)
        {
            message = "No game available. Please join a game first.";
            return;
        }
        MethodResult result = await game.Start();
        switch (result)
        {
            case MethodResult.PlayerWon:
                message = $"Player {game.Players.First(p => p.State == PlayerState.Won).Name} has won the game!";
                break;
            case MethodResult.GameOver:
                message = $"All players have lost the game.";
                break;
            default:
                message = $"Failed to start game: {result}";
                break;
        }
    }

    private string GetGameStateColor()
    {
        return game?.State switch
        {
            GameState.Waiting => "bg-secondary",
            GameState.RedLight => "bg-danger",
            GameState.YellowLight => "bg-warning",
            GameState.GreenLight => "bg-success",
            GameState.Finished => "bg-dark",
            _ => "bg-secondary"
        };
    }

    private void UpdateGame()
    {
        StateHasChanged();
    }
}