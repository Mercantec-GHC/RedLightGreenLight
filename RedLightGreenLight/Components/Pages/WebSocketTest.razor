@page "/websocket-test"
@inject WebSocketService WebSocketService
@implements IDisposable

<PageTitle>WebSocket test</PageTitle>

<h1>WebSocket test</h1>

<div class="mb-3">
    <select class="form-select w-auto d-inline-block" @bind="selectedEvent">
        @foreach (var gameEvent in Enum.GetValues<GameEvent>())
        {
            <option value="@gameEvent">@gameEvent</option>
        }
    </select>

    <input class="form-control w-auto d-inline-block" placeholder="Device ID" @bind="deviceId" />

    <button class="btn btn-primary" @onclick="SendSignalR">Send SignalR</button>
    <button class="btn btn-secondary" @onclick="SendToDevice">Send to device</button>
    <button class="btn btn-warning" @onclick="SendToEveryone">Send to everyone</button>
</div>

@if (!string.IsNullOrEmpty(status))
{
    <p>@status</p>
}

<h4>Received via SignalR</h4>

@if (received.Count == 0)
{
    <p>Nothing received yet.</p>
}
else
{
    <ul>
        @foreach (var webSocketEvent in received)
        {
            <li>@webSocketEvent.Date.ToLocalTime().ToString("HH:mm:ss") - @webSocketEvent.Event</li>
        }
    </ul>
}

@code {
    private readonly List<WebSocketEvent> received = new();

    private GameEvent selectedEvent = GameEvent.GreenLight;

    private string deviceId = string.Empty;

    private string status = string.Empty;

    protected override void OnInitialized()
    {
        WebSocketService.OnSignalR += OnSignalR;
    }

    private Task OnSignalR(WebSocketEvent webSocketEvent)
    {
        return InvokeAsync(() =>
        {
            received.Insert(0, webSocketEvent);

            StateHasChanged();
        });
    }

    private async Task SendSignalR()
    {
        await WebSocketService.SendToWebAppAsync(new WebSocketEvent(selectedEvent, DateTime.UtcNow));

        status = $"Sent {selectedEvent} via SignalR.";
    }

    private async Task SendToDevice()
    {
        if (string.IsNullOrWhiteSpace(deviceId))
        {
            status = "Enter a device ID first.";

            return;
        }

        try
        {
            await WebSocketService.SendToDeviceByIdAsync(deviceId, new WebSocketEvent(selectedEvent, DateTime.UtcNow));

            status = $"Sent {selectedEvent} to device {deviceId}.";
        }
        catch (Exception ex)
        {
            status = $"Failed to send to Mosquitto: {ex.Message}";
        }
    }

    private async Task SendToEveryone()
    {
        try
        {
            await WebSocketService.SendToEveryoneAsync(new WebSocketEvent(selectedEvent, DateTime.UtcNow));

            status = $"Sent {selectedEvent} to everyone.";
        }
        catch (Exception ex)
        {
            status = $"Failed to send to Mosquitto: {ex.Message}";
        }
    }

    public void Dispose()
    {
        WebSocketService.OnSignalR -= OnSignalR;
    }
}
